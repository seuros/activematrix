#!/usr/bin/env ruby
# frozen_string_literal: true

# Launcher for the precompiled daemon: RubyGems installs this as the
# `activematrix` command, and it execs activematrixd from libexec/.
require_relative '../lib/active_matrix/daemon'

begin
  ActiveMatrix::Daemon.exec!(*ARGV)
rescue ActiveMatrix::Daemon::NotFound => e
  warn e.message
  exit 1
end
