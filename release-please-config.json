{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "ruby",
      "package-name": "activematrix",
      "release-as": "0.1.0",
      "version-file": "lib/active_matrix/version.rb",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "crates/activematrixd/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "crates/activematrix-fakehs/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='activematrixd' || @.name.value=='activematrix-fakehs')].version"
        }
      ]
    }
  },
  "bootstrap-sha": "b4c931005056cb94e3b321116cd2d22d06b0d1d6"
}
